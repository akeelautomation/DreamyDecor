# Copy this file to .env.local for local-only values.
# Never put real secrets in .env.example or any other tracked file.

# --- Secrets (do not commit real values) ---
KIE_API_KEY=
PAYMENT_JWT_SECRET= # 32+ chars recommended
PAYPAL_CLIENT_SECRET=
OPENROUTER_API_KEY=

# --- Non-secrets ---
PAYMENT_MODE=auto
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_FALLBACK_MODELS=openai/gpt-4o-mini,qwen/qwen3-vl-8b-instruct,google/gemma-4-26b-a4b-it:free

# Nano Banana Pro cost control (allowed: 1K or 2K; 4K is blocked)
NANO_BANANA_RESOLUTION=2K

# Optional overrides
KIE_API_BASE_URL=https://api.kie.ai
KIE_UPLOAD_BASE_URL=https://kieai.redpandaai.co
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_HTTP_REFERER=https://dreamy-decor.net

# Blog maker image uploads
SITE_URL=https://dreamy-decor.net
PUBLIC_URL_STYLE=extensionless
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
OPENROUTER_MIN_REQUEST_INTERVAL_MS=25000
OPENROUTER_RETRY_COOLDOWN_MS=90000
